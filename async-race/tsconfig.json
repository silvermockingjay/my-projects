{
  "compilerOptions": {
    "target": "ES2022",
    "moduleDetection": "force",
    "module": "ESNext",
    "moduleResolution": "node",
    "noEmit": false,
    "rootDir": "./src",
    "resolveJsonModule": true,
    "allowJs": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "lib": ["es2022", "DOM", "DOM.Iterable"],
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
}
